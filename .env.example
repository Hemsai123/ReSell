# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database - choose engine:
#   Use 'django.db.backends.sqlite3' for local dev (no external DB needed)
#   Use 'django.db.backends.mysql' for production with MySQL
#   Use 'django.db.backends.postgresql' for production with PostgreSQL
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
